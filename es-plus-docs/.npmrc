# @unhead/vue@3.1.1 (via @unhead/bundler) peers on vite >=6.4.2, but this
# site pins vite 4. The vite peer is optional and only used by @unhead/bundler's
# Vite plugin — which es-plus-docs never imports — so the runtime is unaffected.
# EdgeOne runs a bare `npm install` (no flags), so opt into legacy peer resolution
# here instead of the `--legacy-peer-deps` flag used in .github/workflows/deploy-docs.yml.
legacy-peer-deps=true
