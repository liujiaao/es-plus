# ES-Plus 文档开发配置

# 是否使用生产包（true = 使用 dist 打包文件，false = 直接调试源码）
# 开发时设为 false，发布时设为 true 或删除此配置
VITE_USE_PROD_PACKAGE=false

# ── AI CRUD 生成器（/ai-crud）────────────────────────────────────────────
# 只在**构建时**注入，不参与运行时读取的 key。
#
# VITE_AI_BASE_URL：OpenAI 兼容网关地址（末尾到 /v1）。
#   - 本地开发留空即可：dev server 有 /openai 同源代理。
#   - 线上是纯静态托管，没有代理；不配这项时页面默认留空，访客必须自填
#     「允许浏览器跨域（CORS）」的网关，否则只会看到 401/404。
#   - 部署了 infra/ai-relay 后填它的地址（如 https://es-plus-ai-relay.<acct>.workers.dev/v1），
#     并把 VITE_AI_RELAY 设为 true —— 访客就无需自备 key。
# VITE_AI_MODEL：默认模型名（访客仍可在设置里改）。
#
# VITE_AI_RELAY：只有**同时**给了 VITE_AI_BASE_URL 才生效（见 src/utils/ai-endpoint.ts）。
#   只在「中继会替你补上游密钥」时才开；指向普通网关却开了它，页面会以为免 key 可用。
VITE_AI_BASE_URL=
VITE_AI_MODEL=gpt-4o-mini
VITE_AI_RELAY=
