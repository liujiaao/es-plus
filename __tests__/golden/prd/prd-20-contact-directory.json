      { "prop": "title", "label": "职位", "formtype": "Input", "inQuery": false, "inForm": false },
      { "prop": "phone", "label": "手机号", "formtype": "Input", "inForm": false },
      { "prop": "email", "label": "邮箱", "formtype": "Input", "inQuery": false, "inForm": false }
    ]
  },
