{
  "id": "prd-01-user-management",
  "product": "用户管理",
  "target": "vue3",
  "spec": "# 用户管理\n\n【查询区】用户名（输入框）、状态（下拉：启用/停用）\n【列表】用户名、邮箱、手机号、状态、创建时间\n【新增/编辑表单】用户名、邮箱、手机号、状态\n【工具栏】新增\n【行操作】编辑、删除、查看\n说明：创建时间由系统自动写入，表单里不能填。",
  "config": {
    "name": "UserManage",
    "apiUrl": "/api/users",
    "target": "vue3",
    "fields": [
      { "prop": "userName", "label": "用户名", "formtype": "Input" },
      { "prop": "email", "label": "邮箱", "formtype": "Input" },
      { "prop": "phone", "label": "手机号", "formtype": "Input" },
      {
        "prop": "status",
        "label": "状态",
        "formtype": "Select",
        "dataOptions": [
          { "label": "启用", "value": "enabled" },
          { "label": "停用", "value": "disabled" }
        ]
      },
      { "prop": "createdAt", "label": "创建时间", "formtype": "DatePicker", "inQuery": false, "inForm": false }
    ],
    "dialogs": {
      "add": { "title": "新增" },
      "edit": { "title": "编辑" },
      "view": { "title": "查看" }
    }
  },
  "notes": "正例：创建时间是系统字段 → 只在 table；查看 → view 弹窗。"
}
