{
  "nl": "通知公告：查询有公告标题、发布状态、发布时间范围；表格展示标题、发布状态、发布时间、发布人；支持新增、编辑、删除、查看；公告内容在编辑弹窗用自定义 render 展示为富文本摘要。",
  "config": {
    "name": "NoticeManage",
    "apiUrl": "/api/notices",
    "fields": [
      { "prop": "title", "label": "标题", "formtype": "Input" },
      {
        "prop": "published",
        "label": "发布状态",
        "formtype": "Select",
        "dataOptions": [
          { "label": "已发布", "value": 1 },
          { "label": "草稿", "value": 0 }
        ]
      },
      { "prop": "publishTime", "label": "发布时间", "formtype": "DatePicker", "querySpan": 8 },
      { "prop": "publisher", "label": "发布人", "formtype": "Input", "inForm": false },
      {
        "prop": "content",
        "label": "公告内容",
        "formtype": "Input",
        "inQuery": false,
        "inTable": false,
        "attrs": { "type": "textarea" }
      }
    ],
    "actions": ["add", "edit", "delete", "view"],
    "dialogs": {
      "edit": {
        "title": "编辑公告",
        "hasCustomRender": true
      }
    }
  },
  "notes": "custom render dialog via hasCustomRender; content only in form"
}
