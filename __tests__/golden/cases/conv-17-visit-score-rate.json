{
  "nl": "满意度回访：表格展示名称、满意度、日期、状态（已完成/待回访）；满意度在回访后录入；支持新增、编辑、删除。",
  "fixedFields": [
    "name",
    "score",
    "date",
    "status"
  ],
  "pinnedDims": [
    "propSet",
    "actions",
    "formtype:score"
  ],
  "refinements": [
