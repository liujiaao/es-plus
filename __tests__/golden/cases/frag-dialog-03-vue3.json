{
  "scene": "dialog",
  "target": "vue3",
  "pinnedDims": [
    "propSet",
    "formtype:name",
    "formtype:color",
    "formtype:remark",
    "fieldRequired:name",
    "dataOptions:color",
    "fieldAttrs:remark",
    "mode",
    "composableName",
    "defaultTitle",
    "noApiUrl",
    "options.width",
    "options.isDraggable"
  ],
  "config": {
    "fields": [
      {
        "prop": "name",
        "label": "名称",
        "formtype": "Input",
        "required": true
      },
      {
        "prop": "color",
        "label": "颜色",
        "formtype": "Select",
        "dataOptions": [
          {
            "label": "红",
            "value": "red"
          },
          {
            "label": "绿",
            "value": "green"
          },
          {
            "label": "蓝",
            "value": "blue"
          }
        ]
      },
      {
        "prop": "remark",
        "label": "备注",
        "formtype": "Input",
        "attrs": {
          "type": "textarea",
          "maxlength": 100
        }
      }
    ],
    "mode": "composable",
    "composableName": "useTagDialog",
    "defaultTitle": "新建标签",
    "options": {
      "width": "600px",
      "isDraggable": true
    },
    "typescript": true
  },
  "nl": "做一个标签弹窗的 composable（名称 useTagDialog，不要接口，只校验后回调成功）：默认标题「新建标签」；宽 600px、可拖拽；名称必填；颜色下拉（红/绿/蓝）；备注多行文本最多 100 字。",
  "notes": "composable 无接口（noApiUrl）+ 校验型弹窗 + options 尺寸/可拖拽。 target=vue3（同场景三条用例 config 逐字节相同，只差 target）。 AI-47：扩充片段语料（每场景 ≥20 例），nlStatedDims 自证「NL 确实说了」。",
  "fixedFields": [
    "name",
    "color",
    "remark"
  ],
  "nlStatedDims": [
    "propSet",
    "formtype:name",
    "formtype:color",
    "formtype:remark",
    "fieldRequired:name",
    "dataOptions:color",
    "fieldAttrs:remark",
    "mode",
    "composableName",
    "defaultTitle",
    "noApiUrl",
    "options.width",
    "options.isDraggable",
    "target"
  ]
}
