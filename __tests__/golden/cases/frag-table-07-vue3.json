{
  "scene": "table",
  "target": "vue3",
  "pinnedDims": [
    "propSet",
    "fieldLayout:code",
    "extPoints:price",
    "labelKey:code",
    "i18n",
    "noApiUrl",
    "tableOptions.showHeader",
    "tableOptions.border",
    "tableOptions.snIndex",
    "rowButtons"
  ],
  "config": {
    "fields": [
      {
        "prop": "code",
        "label": "编号",
        "labelKey": "field.itemCode",
        "formtype": "Input",
        "width": 120
      },
      {
        "prop": "name",
        "label": "名称",
        "formtype": "Input"
      },
      {
        "prop": "price",
        "label": "价格",
        "formtype": "InputNumber",
        "align": "right",
        "permissionValue": "price:view"
      },
      {
        "prop": "status",
        "label": "状态",
        "formtype": "Select",
        "dataOptions": [
          {
            "label": "上架",
            "value": "on"
          },
          {
            "label": "下架",
            "value": "off"
          }
        ]
      }
    ],
    "i18n": true,
    "tableOptions": {
      "showHeader": false,
      "border": false,
      "snIndex": true
    },
    "rowButtons": [
      {
        "name": "编辑",
        "type": "primary",
        "key": "edit"
      }
    ],
    "typescript": true
  },
  "nl": "做一个启用 i18n 的物料表格（不接接口、数据手动接入）：编号显式 labelKey field.itemCode、宽 120；名称；价格只有 price:view 权限才显示、右对齐；状态（上架/下架）；关闭边框、隐藏表头、显示序号列；行内「编辑」按钮（主按钮）。",
  "notes": "i18n + 显式 labelKey + 字段级 permissionValue + 无接口（noApiUrl）。 target=vue3（同场景三条用例 config 逐字节相同，只差 target）。 AI-47：扩充片段语料（每场景 ≥20 例），nlStatedDims 自证「NL 确实说了」。",
  "fixedFields": [
    "code",
    "name",
    "price",
    "status"
  ],
  "nlStatedDims": [
    "propSet",
    "fieldLayout:code",
    "extPoints:price",
    "labelKey:code",
    "i18n",
    "noApiUrl",
    "tableOptions.showHeader",
    "tableOptions.border",
    "tableOptions.snIndex",
    "rowButtons",
    "rowButtonNames",
    "target"
  ]
}
