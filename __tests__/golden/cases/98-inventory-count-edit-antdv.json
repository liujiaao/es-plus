{
  "nl": "盘点数量录入：单击单元格进入行内编辑；展示货品名称、盘点数；支持新增、编辑。",
  "nlEn": "Inventory count entry: click a cell to edit inline. Shows item name and counted quantity. Supports add and edit.",
  "fixedFields": ["itemName", "count"],
  "pinnedDims": ["propSet", "actions", "editConfig", "columns", "virtualScroll", "target"],
  "config": {
    "name": "InventoryCountEditManage",
    "apiUrl": "/api/inventory-count",
    "target": "antdv",
    "fields": [
      { "prop": "itemName", "label": "货品名称", "formtype": "Input" },
      { "prop": "count", "label": "盘点数", "formtype": "InputNumber", "inQuery": false }
    ],
    "tableOptions": { "engine": "vxe", "editConfig": { "trigger": "click", "mode": "cell" } },
    "columns": [
      { "prop": "itemName", "label": "货品名称", "editRender": { "name": "$input" } },
      { "prop": "count", "label": "盘点数", "editRender": { "name": "$input", "props": { "type": "number" } } }
    ],
    "actions": ["add", "edit"]
  },
  "notes": "AI-09 子项④: vxe 行内编辑（editConfig click/cell + editRender，antdv/schema）"
}
