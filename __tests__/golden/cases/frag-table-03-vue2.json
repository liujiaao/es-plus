{
  "scene": "table",
  "target": "vue2",
  "pinnedDims": [
    "propSet",
    "fieldLayout:orderNo",
    "fieldLayout:customer",
    "fieldLayout:amount",
    "extPoints:amount",
    "apiUrl",
    "rowButtons",
    "tableOptions.defaultSort",
    "pagination.pageSize"
  ],
  "config": {
    "fields": [
      {
        "prop": "orderNo",
        "label": "订单号",
        "formtype": "Input",
        "width": 140,
        "align": "center"
      },
      {
        "prop": "customer",
        "label": "客户",
        "formtype": "Input",
        "minWidth": 160,
        "ellipsis": true
      },
      {
        "prop": "amount",
        "label": "金额",
        "formtype": "InputNumber",
        "align": "right",
        "formatter": "(row) => Number(row.amount).toFixed(2)"
      },
      {
        "prop": "createdAt",
        "label": "下单时间",
        "formtype": "DatePicker",
        "width": 180
      }
    ],
    "apiUrl": "/api/orders",
    "tableOptions": {
      "stripe": false,
      "size": "small",
      "defaultSort": {
        "prop": "createdAt",
        "order": "descending"
      }
    },
    "pagination": {
      "pageSize": 20,
      "pageSizes": [
        10,
        20,
        50
      ]
    },
    "rowButtons": [
      {
        "name": "详情",
        "key": "detail"
      },
      {
        "name": "取消",
        "type": "warning",
        "key": "cancel"
      }
    ],
    "typescript": true
  },
  "nl": "做一个订单列表表格：订单号（宽 140、居中）、客户（最小宽 160、超长省略）、金额（右对齐、保留两位小数）、下单时间（日期、宽 180）；接口 /api/orders；斑马纹关闭、紧凑尺寸；默认按下单时间倒序；每页 20 条、可选 10/20/50；行内「详情」「取消（warning）」两个按钮。",
  "notes": "表格容器词汇（分页/排序/列宽对齐/行按钮 type）。 target=vue2（同场景三条用例 config 逐字节相同，只差 target）。 AI-47：扩充片段语料（每场景 ≥20 例），nlStatedDims 自证「NL 确实说了」。",
  "fixedFields": [
    "orderNo",
    "customer",
    "amount",
    "createdAt"
  ],
  "nlStatedDims": [
    "propSet",
    "fieldLayout:orderNo",
    "fieldLayout:customer",
    "fieldLayout:amount",
    "fieldLayout:createdAt",
    "extPoints:amount",
    "apiUrl",
    "rowButtons",
    "rowButtonNames",
    "tableOptions.stripe",
    "tableOptions.size",
    "tableOptions.defaultSort",
    "pagination.pageSize",
    "pagination.pageSizes",
    "target"
  ]
}
