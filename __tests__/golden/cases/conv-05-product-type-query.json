        ]
      },
      {
        "prop": "status",
        "label": "状态",
        "formtype": "Select",
        "inQuery": false,
        "dataOptions": [
          {
            "label": "上架",
            "value": "on"
          },
          {
            "label": "下架",
            "value": "off"
          }
        ]
      },
      {
        "prop": "amount",
        "label": "金额",
        "formtype": "InputNumber",
        "inQuery": false
