{
  "nl": "商品管理：初版只要能按名称搜索；表格展示名称、类型（实物/虚拟）、状态（上架/下架）、金额；支持新增、编辑、删除。",
  "fixedFields": [
    "name",
    "type",
    "status",
    "amount"
  ],
  "pinnedDims": [
    "propSet",
    "actions",
    "inQuery:type"
  ],
  "refinements": [
    {
      "turn": 1,
      "correction": "类型也要能筛选，实物和虚拟商品要分开看。"
    }
