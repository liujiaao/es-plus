{
  "scene": "table",
  "target": "vue3",
  "pinnedDims": [
    "propSet",
    "formtype:name",
    "formtype:status",
    "formtype:amount",
    "formtype:createdAt",
    "dataOptions:status",
    "rowButtonNames"
  ],
  "config": {
    "fields": [
      {
        "prop": "name",
        "label": "姓名",
        "formtype": "Input"
      },
      {
        "prop": "status",
        "label": "状态",
        "formtype": "Select",
        "dataOptions": [
          {
            "label": "启用",
            "value": 1
          },
          {
            "label": "禁用",
            "value": 0
          }
        ]
      },
      {
        "prop": "amount",
        "label": "金额",
        "formtype": "InputNumber",
        "align": "right",
        "formatter": "(row) => Number(row.amount).toFixed(2)"
      },
      {
        "prop": "createdAt",
        "label": "创建时间",
        "formtype": "DatePicker"
      }
    ],
    "apiUrl": "/api/users",
    "tableOptions": {
      "border": true,
      "stripe": true,
      "rowkey": "id",
      "highlightCurrentRow": false
    },
    "rowButtons": [
      {
        "name": "查看",
        "key": "view"
      },
      {
        "name": "编辑",
        "type": "primary",
        "key": "edit"
      },
      {
        "name": "删除",
        "type": "danger",
        "key": "delete"
      }
    ],
    "typescript": true
  },
  "nl": "做一个只读的用户表格：显示姓名、状态（启用/禁用）、金额、创建时间，带查看/编辑/删除三个行内按钮。",
  "notes": "独立 es-table 场景（不经 CRUD 组合）。字段刻意走到 buildTableColumnSFC 的各分支：Select+dataOptions、InputNumber 带 align/formatter（formatter 是源码扩展点，发射前过 assertEmittableExpr 语法闸）、DatePicker。 target=vue3（同场景三条用例 config 逐字节相同，只差 target）。"
}
