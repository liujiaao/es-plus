{
  "nl": "物料管理：表格展示名称、状态（可用/停用）；备注只在新增/编辑弹窗里填，列表里不显示；支持新增、编辑、删除。",
  "fixedFields": [
    "name",
    "status",
    "remark"
  ],
  "pinnedDims": [
    "propSet",
    "actions",
    "inTable:remark"
  ],
  "refinements": [
    {
      "turn": 1,
      "correction": "备注也要在列表里显示，盘点时方便一眼看到。"
    }
  ],
  "convergesBy": 1,
  "config": {
    "name": "Conv08MaterialRemarkTable",
    "apiUrl": "/api/material-remark-table",
