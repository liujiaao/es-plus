{
  "scene": "table",
  "target": "vue3",
  "pinnedDims": [
    "propSet",
    "fieldLayout:sku",
    "fieldLayout:title",
    "fieldLayout:price",
    "fieldLayout:updatedAt",
    "extPoints:price",
    "apiUrl",
    "tableVirtualMode",
    "tableOptions.editConfig",
    "tableOptions.heightType",
    "tableOptions.tabHeight"
  ],
  "config": {
    "fields": [
      {
        "prop": "sku",
        "label": "SKU",
        "formtype": "Input",
        "fixed": "left",
        "width": 120
      },
      {
        "prop": "title",
        "label": "标题",
        "formtype": "Input",
        "minWidth": 200,
        "ellipsis": true
      },
      {
        "prop": "price",
        "label": "价格",
        "formtype": "InputNumber",
        "align": "right",
        "formatter": "(row) => \"¥\" + Number(row.price).toFixed(2)"
      },
      {
        "prop": "stock",
        "label": "库存",
        "formtype": "InputNumber",
        "align": "right"
      },
      {
        "prop": "updatedAt",
        "label": "更新时间",
        "formtype": "DatePicker",
        "width": 160
      }
    ],
    "apiUrl": "/api/goods",
    "tableOptions": {
      "engine": "vxe",
      "editConfig": {
        "trigger": "dblclick",
        "mode": "cell",
        "showStatus": true,
        "autoClear": true
      },
      "heightType": "maxHeight",
      "tabHeight": 520
    },
    "typescript": true
  },
  "nl": "做一个商品表格：用 vxe 引擎做单元格编辑——双击进入、按单元格、显示状态、自动清空；高度类型 maxHeight、高 520；SKU 左固定、宽 120；标题最小宽 200、超长省略；价格右对齐并格式化为 ¥ 两位小数；库存右对齐；更新时间日期、宽 160；接口 /api/goods。",
  "notes": "vxe 引擎（无 virtual）+ editConfig + 固定列 + formatter（engine 语义维修正的语料）。 target=vue3（同场景三条用例 config 逐字节相同，只差 target）。 AI-47：扩充片段语料（每场景 ≥20 例），nlStatedDims 自证「NL 确实说了」。",
  "fixedFields": [
    "sku",
    "title",
    "price",
    "stock",
    "updatedAt"
  ],
  "nlStatedDims": [
    "propSet",
    "fieldLayout:sku",
    "fieldLayout:title",
    "fieldLayout:price",
    "fieldLayout:updatedAt",
    "extPoints:price",
    "apiUrl",
    "tableVirtualMode",
    "tableOptions.editConfig",
    "tableOptions.heightType",
    "tableOptions.tabHeight",
    "target"
  ]
}
