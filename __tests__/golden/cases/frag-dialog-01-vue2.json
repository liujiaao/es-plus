{
  "scene": "dialog",
  "target": "vue2",
  "pinnedDims": [
    "propSet",
    "formtype:name",
    "formtype:status",
    "fieldRequired:name",
    "mode",
    "target"
  ],
  "config": {
    "fields": [
      {
        "prop": "name",
        "label": "姓名",
        "formtype": "Input",
        "required": true
      },
      {
        "prop": "status",
        "label": "状态",
        "formtype": "Select",
        "dataOptions": [
          {
            "label": "启用",
            "value": 1
          },
          {
            "label": "禁用",
            "value": 0
          }
        ]
      }
    ],
    "apiUrl": "/api/users",
    "rowkey": "id",
    "composableName": "useUserDialog",
    "typescript": true
  },
  "nl": "做一个用户编辑弹窗的 composable：姓名必填、状态下拉，带接口地址，提交后关闭。",
  "notes": "独立 useDialog 场景。产物是 composable 模块（非 SFC），编译尺子按 tsx 整块解析 —— 与 form/table 的 SFC 切块解析是不同的验证路径。 target=vue2（同场景三条用例 config 逐字节相同，只差 target）。"
}
