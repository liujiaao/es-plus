{
  "nl": "发票管理：表格展示标题、发票类型（专票/普票）、税号、金额；支持新增、编辑、删除。",
  "fixedFields": [
    "title",
    "invoiceType",
    "taxNo",
    "amount"
  ],
  "pinnedDims": [
    "propSet",
    "actions",
    "isHidden:taxNo"
  ],
  "refinements": [
    {
      "turn": 1,
      "correction": "发票类型不是专票时，税号字段要隐藏起来。"
    }
  ],
  "convergesBy": 1,
  "config": {
    "name": "Conv21InvoiceTaxnoHidden",
    "apiUrl": "/api/invoice-taxno-hidden",
    "fields": [
      {
        "prop": "title",
        "label": "标题",
        "formtype": "Input",
        "inQuery": false
      },
      {
        "prop": "invoiceType",
        "label": "发票类型",
        "formtype": "Select",
        "inQuery": false,
        "dataOptions": [
          {
            "label": "专票",
            "value": "special"
          },
          {
            "label": "普票",
            "value": "normal"
          }
        ]
      },
      {
        "prop": "taxNo",
        "label": "税号",
        "formtype": "Input",
        "inQuery": false,
        "isHidden": {
          "field": "invoiceType",
          "op": "ne",
          "value": "special"
        }
      },
      {
        "prop": "amount",
        "label": "金额",
        "formtype": "InputNumber",
        "inQuery": false
      }
    ],
    "actions": [
      "add",
      "edit",
      "delete"
    ]
  },
  "notes": "isHidden 铰链：初版完全没提条件显隐，turn-0 必然没有 isHidden（结构性 miss）；纠正给出「不是专票就隐藏税号」→ {field,op:ne,value}。"
}
