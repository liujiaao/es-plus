{
  "nl": "合同管理：查询条件有合同编号、签约方；表格展示合同编号、签约方、签约金额、签约日期；表格上方有“新增合同”按钮，行内有编辑、删除。新增合同的弹窗不要右上角的关闭按钮，点遮罩、按 ESC 都不许关；弹窗底部只保留“提交审批”和“取消”。",
  "nlEn": "Contract management: query conditions are contract number and signing party; the table shows contract number, signing party, contract amount, and signing date; above the table there is an \"Add Contract\" button and each row has edit and delete. The add-contract dialog must not have the close (X) entry in the top-right corner, and clicking the mask or pressing ESC must not close it; the dialog footer keeps only \"Submit for approval\" and \"Cancel\".",
  "fixedFields": ["contractNo", "party", "amount", "signDate"],
  "pinnedDims": ["propSet", "actions", "dialogs"],
  "config": {
    "name": "ContractManage",
    "apiUrl": "/api/contracts",
    "fields": [
      { "prop": "contractNo", "label": "合同编号", "formtype": "Input" },
      { "prop": "party", "label": "签约方", "formtype": "Input" },
      { "prop": "amount", "label": "签约金额", "formtype": "InputNumber", "inQuery": false },
      { "prop": "signDate", "label": "签约日期", "formtype": "DatePicker", "inQuery": false }
    ],
    "actions": ["add", "edit", "delete"],
    "toolbarBtns": [
      { "name": "新增合同", "key": "add", "type": "primary", "dialogKey": "add" }
    ],
    "operationColumn": {
      "label": "操作",
      "btns": [
        { "name": "编辑", "key": "edit", "dialogKey": "edit" },
        { "name": "删除", "key": "delete", "confirm": "确定删除该合同吗？" }
      ]
    },
    "dialogs": {
      "add": {
        "title": "新增合同",
        "showClose": false,
        "closeOnClickModal": false,
        "closeOnPressEscape": false,
        "formItems": [
          { "prop": "contractNo", "label": "合同编号", "formtype": "Input" },
          { "prop": "party", "label": "签约方", "formtype": "Input" },
          { "prop": "amount", "label": "签约金额", "formtype": "InputNumber" },
          { "prop": "signDate", "label": "签约日期", "formtype": "DatePicker" }
        ],
        "configBtn": [
          { "name": "提交审批", "type": "primary", "action": "confirm" },
          { "name": "取消", "action": "cancel" }
        ]
      },
      "edit": {
        "title": "编辑合同",
        "formItems": [
          { "prop": "contractNo", "label": "合同编号", "formtype": "Input" },
          { "prop": "party", "label": "签约方", "formtype": "Input" },
          { "prop": "amount", "label": "签约金额", "formtype": "InputNumber" },
          { "prop": "signDate", "label": "签约日期", "formtype": "DatePicker" }
        ]
      }
    }
  },
  "notes": "AI-27: dialog base data keys (showClose / closeOnClickModal / closeOnPressEscape) + declarative configBtn; also the explicit-button-mode rule (dialogs ⇒ toolbarBtns + operationColumn must be declared, otherwise nothing opens the dialog)."
}
