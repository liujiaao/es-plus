      { "prop": "amount", "label": "金额", "editRender": { "name": "$input", "props": { "type": "number", "placeholder": "请输入金额" } } }
    ],
    "actions": ["edit"]
  },
  "notes": "AI-09 子项④: vxe 行内编辑（editConfig dblclick + editRender props placeholder，antdv/sfc）"
