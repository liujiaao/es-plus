{
  "nl": "合同管理：表格上方右侧是“新增合同”按钮，左侧是“批量导出”；表格展示合同编号、金额、签署日期；支持新增、删除、查看；金额保留两位小数。",
  "config": {
    "name": "ContractManage",
    "apiUrl": "/api/contracts",
    "fields": [
      { "prop": "contractNo", "label": "合同编号", "formtype": "Input" },
      {
        "prop": "amount",
        "label": "金额",
        "formtype": "Input",
        "inQuery": false,
        "formatter": "(row) => `¥${Number(row.amount).toFixed(2)}`"
      },
      { "prop": "signedAt", "label": "签署日期", "formtype": "DatePicker", "inForm": false }
    ],
    "actions": ["add", "delete", "view"],
    "tableBtns": [
      { "name": "批量导出", "position": "left", "actionType": "export" },
      { "name": "新增合同", "type": "primary", "position": "right", "dialogKey": "add" }
    ],
    "operationColumn": {
      "label": "操作",
      "btns": [
        { "name": "查看", "dialogKey": "view" },
        { "name": "删除", "confirm": "确定删除该合同吗？" }
      ]
    }
  },
  "notes": "position:'left'/'right' 是渲染器契约的推荐定位字段（code:1/2 为旧别名）。本用例锁定：position 不得被 Zod 静默 strip 成 code:1（否则右侧按钮会跑到左侧），且必须归一化成一致的 code 供下游读取。"
}
