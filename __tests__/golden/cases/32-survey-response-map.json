{
  "nl": "问卷管理：查询有问卷标题、状态（草稿/发布/归档）；表格展示问卷标题、状态、回收份数、创建时间；支持新增、编辑、删除。后端分页接口返回 { items, total, size, page }。",
  "nlEn": "Survey management: query by survey title and status (draft/published/archived); the table shows survey title, status, response count, and created time; supports add, edit, and delete. The backend paged endpoint returns { items, total, size, page }.",
  "fixedFields": ["title", "status", "responses", "createdAt"],
  "pinnedDims": ["propSet", "actions", "configTableOut"],
  "config": {
    "name": "SurveyManage",
    "apiUrl": "/api/surveys",
    "target": "vue3",
    "fields": [
      { "prop": "title", "label": "问卷标题", "formtype": "Input" },
      {
        "prop": "status",
        "label": "状态",
        "formtype": "Select",
        "dataOptions": [
          { "label": "草稿", "value": "draft" },
          { "label": "发布", "value": "published" },
          { "label": "归档", "value": "archived" }
        ]
      },
      { "prop": "responses", "label": "回收份数", "formtype": "InputNumber", "inQuery": false },
      { "prop": "createdAt", "label": "创建时间", "formtype": "DatePicker", "inQuery": false, "inForm": false }
    ],
    "actions": ["add", "edit", "delete"],
    "tableOptions": {
      "configTableOut": { "tableData": "items", "total": "total", "pageSize": "size", "current": "page" }
    }
  },
  "notes": "AI-08: all four keys remapped (tableData/total/pageSize/current) (vue3/schema)"
}
