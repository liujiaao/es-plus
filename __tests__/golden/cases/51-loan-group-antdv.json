{
  "nl": "贷款申请管理：查询有客户姓名、贷款类型；表格用两级表头——「客户」下分客户姓名、手机号，「贷款」下分贷款类型、金额；支持新增、编辑、删除。",
  "nlEn": "Loan application management: query by customer name and loan type; the table uses two-level group headers — \"Customer\" grouping customer name and phone, and \"Loan\" grouping loan type and amount; supports add, edit, and delete.",
  "fixedFields": ["customerName", "phone", "loanType", "amount"],
  "pinnedDims": ["propSet", "actions", "columns", "target"],
  "config": {
    "name": "LoanApplyManage",
    "apiUrl": "/api/loan-applications",
    "target": "antdv",
    "fields": [
      { "prop": "customerName", "label": "客户姓名", "formtype": "Input" },
      { "prop": "phone", "label": "手机号", "formtype": "Input", "inQuery": false },
      {
        "prop": "loanType",
        "label": "贷款类型",
        "formtype": "Select",
        "dataOptions": [
          { "label": "信用贷", "value": "credit" },
          { "label": "抵押贷", "value": "mortgage" }
        ]
      },
      { "prop": "amount", "label": "金额", "formtype": "InputNumber", "inQuery": false }
    ],
    "columns": [
      {
        "label": "客户",
        "groups": [
          { "prop": "customerName", "label": "客户姓名" },
          { "prop": "phone", "label": "手机号" }
        ]
      },
      {
        "label": "贷款",
        "groups": [
          { "prop": "loanType", "label": "贷款类型" },
          { "prop": "amount", "label": "金额" }
        ]
      }
    ],
    "actions": ["add", "edit", "delete"]
  },
  "notes": "AI-09 子项①: groups 多级表头（antdv/schema）"
}
