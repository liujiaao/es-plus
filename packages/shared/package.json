{
  "name": "@es-plus/shared",
  "version": "1.4.0",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./contract": {
      "types": "./build/contract.d.ts",
      "import": "./build/contract.js"
    }
  },
  "files": [
    "build",
    "schemas"
  ],
  "sideEffects": false,
  "description": "es-plus shared toolchain: structured config schema, CRUD code generators, and the NL→config prompt used by @es-plus/cli and @es-plus/mcp-server",
  "keywords": [
    "es-plus",
    "codegen",
    "json-schema",
    "zod",
    "crud"
  ],
  "author": "liujiaao <303363554@qq.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liujiaao/es-plus.git",
    "directory": "packages/shared"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:update": "vitest run --update"
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
