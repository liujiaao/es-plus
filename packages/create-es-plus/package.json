{
  "name": "create-es-plus",
  "version": "0.1.0",
  "description": "Scaffold a runnable ES-Plus project in one command: npm create es-plus@latest. Pick a renderer (Vue 3 + Element Plus / Vue 2 + Element UI / Vue 3 + Ant Design Vue) and optionally wire the AI (MCP) toolchain.",
  "type": "module",
  "bin": {
    "create-es-plus": "./build/index.js"
  },
  "main": "./build/index.js",
  "files": [
    "build",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "es-plus",
    "create",
    "scaffold",
    "starter",
    "vue3",
    "vue2",
    "element-plus",
    "element-ui",
    "ant-design-vue",
    "crud",
    "ai",
    "mcp"
  ],
  "author": "liujiaao <303363554@qq.com>",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/liujiaao/es-plus.git",
    "directory": "packages/create-es-plus"
  },
  "homepage": "https://liujiaao.github.io/es-plus/",
  "bugs": {
    "url": "https://github.com/liujiaao/es-plus/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "prompts": "^2.4.2",
    "picocolors": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.0",
    "typescript": "^5.3.0"
  }
}
