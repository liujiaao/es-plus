{
  "name": "es-plus-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky || exit 0",
    "test": "npm test --workspaces --if-present",
    "lint": "eslint . --max-warnings 9999",
    "lint:fix": "eslint . --fix",
    "schemas:sync": "node scripts/sync-schemas.mjs",
    "schemas:check": "node scripts/sync-schemas.mjs --check",
    "check:exports": "node scripts/check-type-exports.mjs",
    "check:schema": "node scripts/check-schema-contract.mjs",
    "check:generator": "node scripts/check-generator-contract.mjs",
    "check:parity": "node scripts/check-renderer-parity.mjs",
    "check:consistency": "npm run check:exports && npm run check:schema && npm run check:generator && npm run check:parity && npm run schemas:check",
    "test:golden": "node __tests__/golden/scripts/score-golden.mjs",
    "golden:e2e": "node __tests__/e2e/scripts/run-golden.mjs",
    "eval:llm": "node scripts/eval-llm.mjs",
    "build:packages": "npm run schemas:sync && npm run build --workspace @es-plus/shared && npm run build --workspace @es-plus/vue3 && npm run build --workspace @es-plus/vue2 && npm run build --workspace @es-plus/adapter-antdv && npm run build --workspace @es-plus/cli && npm run build --workspace @es-plus/mcp-server",
    "test:e2e": "node __tests__/e2e/scripts/run-all.mjs",
    "test:e2e:single": "node __tests__/e2e/scripts/run-e2e.mjs",
    "promote:dry": "node scripts/promote-beta-to-latest.mjs",
    "promote:apply": "node scripts/promote-beta-to-latest.mjs --apply"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.60.1",
    "vue-eslint-parser": "^9.4.3"
  }
}
