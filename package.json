{
  "name": "es-plus-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky || exit 0",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:libs": "npm run build --workspace @es-plus/core && npm run build --workspace @es-plus/shared",
    "lint": "eslint . --max-warnings 9999",
    "lint:fix": "eslint . --fix",
    "schemas:sync": "node scripts/sync-schemas.mjs",
    "schemas:check": "node scripts/sync-schemas.mjs --check",
    "docs:sync": "node scripts/sync-docs.mjs",
    "docs:check": "node scripts/sync-docs.mjs --check",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "tokens:check": "node scripts/sync-tokens.mjs --check",
    "brand:sync": "node scripts/sync-brand.mjs",
    "brand:check": "node scripts/sync-brand.mjs --check",
    "tri-render:sync": "node scripts/sync-tri-render.mjs",
    "tri-render:check": "node scripts/sync-tri-render.mjs --check",
    "tri-render:pairs": "node scripts/gen-tri-render-pairs.mjs",
    "tri-render:pairs:check": "node scripts/gen-tri-render-pairs.mjs --check",
    "tri-render:gen": "node scripts/gen-tri-render-snapshots.mjs",
    "cases:sync": "node scripts/sync-cases.mjs",
    "cases:check": "node scripts/sync-cases.mjs --check",
    "ai:sync": "node scripts/sync-ai.mjs",
    "ai:check": "node scripts/sync-ai.mjs --check",
    "theme:sync": "node scripts/sync-theme.mjs",
    "theme:check": "node scripts/sync-theme.mjs --check",
    "element-theme:sync": "node scripts/gen-element-theme.mjs",
    "element-theme:check": "node scripts/gen-element-theme.mjs --check",
    "check:exports": "node scripts/check-type-exports.mjs",
    "check:schema": "node scripts/check-schema-contract.mjs",
    "check:generator": "node scripts/check-generator-contract.mjs",
    "check:parity": "node scripts/check-renderer-parity.mjs",
    "check:api": "node scripts/check-exposed-api.mjs",
    "check:contract": "node scripts/check-contract-consumption.mjs",
    "check:site-nav": "node scripts/check-site-nav.mjs",
    "check:readme": "node scripts/check-readme-claims.mjs",
    "check:theme-bridge": "node scripts/check-theme-bridge.mjs",
    "check:consistency": "npm run check:exports && npm run check:schema && npm run check:generator && npm run check:parity && npm run check:api && npm run check:contract && npm run check:site-nav && npm run check:readme && npm run check:site-claims && npm run check:data-schemas && npm run check:brand-assets && npm run check:theme-bridge && npm run schemas:check && npm run docs:check && npm run check:docs-layout && npm run tokens:check && npm run brand:check && npm run tri-render:check && npm run tri-render:pairs:check && npm run cases:check && npm run check:cases-links && npm run ai:check && npm run theme:check && npm run element-theme:check && npm run one-config:check && npm run data-schemas:check && npm run og:check",
    "test:golden": "node __tests__/golden/scripts/score-golden.mjs",
    "golden:e2e": "node __tests__/e2e/scripts/run-golden.mjs",
    "eval:llm": "node scripts/eval-llm.mjs",
    "build:packages": "npm run schemas:sync && npm run build --workspace @es-plus/core && npm run build --workspace @es-plus/shared && npm run build --workspace @es-plus/vue3 && npm run build --workspace @es-plus/vue2 && npm run build --workspace @es-plus/adapter-antdv && npm run build --workspace @es-plus/cli && npm run build --workspace @es-plus/mcp-server",
    "test:e2e": "node __tests__/e2e/scripts/run-all.mjs",
    "test:e2e:single": "node __tests__/e2e/scripts/run-e2e.mjs",
    "pretest:e2e:runtime": "npm run build --workspace @es-plus/vue2",
    "test:e2e:runtime": "playwright test -c __tests__/e2e-runtime/playwright.config.ts",
    "one-config:gen": "node scripts/gen-one-config-diff.mjs",
    "one-config:check": "node scripts/gen-one-config-diff.mjs --check",
    "check:site-claims": "node scripts/check-site-claims.mjs",
    "check:cases-links": "node scripts/check-cases-links.mjs",
    "data-schemas:sync": "node scripts/sync-data-schemas.mjs",
    "data-schemas:check": "node scripts/sync-data-schemas.mjs --check",
    "check:data-schemas": "node scripts/check-data-schemas.mjs",
    "og:gen": "node scripts/gen-og-image.mjs",
    "og:check": "node scripts/gen-og-image.mjs --check",
    "check:brand-assets": "node scripts/check-brand-assets.mjs",
    "check:docs-layout": "node scripts/check-docs-layout.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.62.0",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.21.5",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "typescript-eslint": "^8.60.1",
    "vue-eslint-parser": "^9.4.3"
  }
}
