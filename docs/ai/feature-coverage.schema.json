{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AI 可达性台账（feature-coverage）",
  "description": "文档站 96 例特性演示 × 分层可达性的单一真源。结构守卫：scripts/check-feature-coverage.mjs；Ajv 校验：scripts/check-data-schemas.mjs。",
  "type": "object",
  "additionalProperties": false,
  "required": ["note", "tiers", "demos"],
  "properties": {
    "$schema": { "type": "string" },
    "note": { "type": "string", "minLength": 1 },
    "tiers": {
      "description": "四档释义（A 前门声明式 / B from_config / C 逃生舱·函数值 / D 非 AI 目标）",
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": { "type": "string", "minLength": 1 },
        "B": { "type": "string", "minLength": 1 },
        "C": { "type": "string", "minLength": 1 },
        "D": { "type": "string", "minLength": 1 }
      }
    },
    "demos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "title", "tokens"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(form|table|crud-page|dialog|advanced|vxe-table)/\\d{2}-[a-z0-9-]+$",
            "description": "文档引用串本身（<category>/<NN>-<slug>），由 resolveComponentPath 规则映射到磁盘 .vue"
          },
          "group": {
            "type": "string",
            "enum": ["es-form", "es-table", "es-crud-page", "use-dialog", "linkage", "vxe-table"]
          },
          "title": { "type": "string", "minLength": 1 },
          "tokens": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "能力令牌（须 ∈ scripts/feature-coverage.data.mjs 的 CAPABILITY_TOKENS）"
          },
          "note": { "type": "string" }
        }
      }
    }
  }
}
